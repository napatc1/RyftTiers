# RyftTiers queue system — Minemen/MCPvP style practice
# Requires: Skript 2.17+
#
# Commands:
#   /play <mode>         — join ranked queue
#   /unqueue             — leave queue
#   /spectate <player>   — watch a duel
#   /unspectate          — stop spectating
#   /stats [player]      — view ELO & W/L
#   /lb <mode>           — top 10 leaderboard
#   /elo reset <player>  — (op) reset a player's ELO
#
# Modes: eval, drain, free, uhc, sword, axe, nethpot, mace, spear-mace, smp, cart
#
# ELO: starts at 1000, K=32, standard formula

# ── ELO helpers ───────────────────────────────────────────────────────────────

function getElo(uid: text, mode: text) :: number:
    if {elo::%{_uid}%::%{_mode}%} is set:
        return {elo::%{_uid}%::%{_mode}%}
    return 1000

function setElo(uid: text, mode: text, val: number):
    set {elo::%{_uid}%::%{_mode}%} to round({_val})

function calcElo(myElo: number, oppElo: number, won: boolean) :: number:
    set {_expected} to 1 / (1 + 10 ^ (({_oppElo} - {_myElo}) / 400))
    if {_won} is true:
        set {_actual} to 1
    else:
        set {_actual} to 0
    return {_myElo} + (32 * ({_actual} - {_expected}))

# ── Mode helpers ──────────────────────────────────────────────────────────────

function modeToKit(mode: text) :: text:
    if {_mode} is "eval":
        return "vanilla-eval"
    else if {_mode} is "drain":
        return "vanilla-drain"
    else if {_mode} is "free":
        return "vanilla-free"
    else if {_mode} is "uhc":
        return "uhc"
    else if {_mode} is "sword":
        return "sword"
    else if {_mode} is "axe":
        return "axe"
    else if {_mode} is "nethpot":
        return "nethpot"
    else if {_mode} is "mace":
        return "mace"
    else if {_mode} is "spear-mace":
        return "spear-mace"
    else if {_mode} is "smp":
        return "smp"
    else if {_mode} is "cart":
        return "cart"
    return ""

function modeLabel(mode: text) :: text:
    if {_mode} is "eval":
        return "Vanilla Eval"
    else if {_mode} is "drain":
        return "Vanilla Drain"
    else if {_mode} is "free":
        return "Vanilla Free"
    else if {_mode} is "uhc":
        return "UHC"
    else if {_mode} is "sword":
        return "Sword"
    else if {_mode} is "axe":
        return "Axe"
    else if {_mode} is "nethpot":
        return "NethPot"
    else if {_mode} is "mace":
        return "Mace"
    else if {_mode} is "spear-mace":
        return "Spear Mace"
    else if {_mode} is "smp":
        return "SMP"
    else if {_mode} is "cart":
        return "Cart"
    return {_mode}

# ── Queue helpers ──────────────────────────────────────────────────────────────

function leaveQueue(uid: text):
    set {_mode} to {queue::player::%{_uid}%}
    if {_mode} is not set:
        stop
    remove {_uid} from {queue::list::%{_mode}%::*}
    delete {queue::player::%{_uid}%}

function tryMatch(mode: text):
    if size of {queue::list::%{_mode}%::*} < 2:
        stop
    set {_uid1} to first element of {queue::list::%{_mode}%::*}
    set {_uid2} to second element of {queue::list::%{_mode}%::*}
    remove {_uid1} from {queue::list::%{_mode}%::*}
    remove {_uid2} from {queue::list::%{_mode}%::*}
    delete {queue::player::%{_uid1}%}
    delete {queue::player::%{_uid2}%}
    set {_p1} to ""
    set {_p2} to ""
    loop all players:
        if "%uuid of loop-player%" is {_uid1}:
            set {_p1} to loop-player
        if "%uuid of loop-player%" is {_uid2}:
            set {_p2} to loop-player
    if {_p1} is "":
        add {_uid2} to {queue::list::%{_mode}%::*}
        set {queue::player::%{_uid2}%} to {_mode}
        stop
    if {_p2} is "":
        add {_uid1} to {queue::list::%{_mode}%::*}
        set {queue::player::%{_uid1}%} to {_mode}
        stop
    set {_kit} to modeToKit({_mode})
    set {_label} to modeLabel({_mode})
    set {_rounds} to 3
    if {_mode} is "uhc":
        set {_rounds} to 2
    set {duel::queue_mode::%{_uid1}%} to {_mode}
    set {duel::queue_mode::%{_uid2}%} to {_mode}
    startDuelNow({_uid1}, {_uid2}, {_p1}, {_p2}, {_kit}, {_label}, {_rounds}, false)

# ── /play ──────────────────────────────────────────────────────────────────────

command /play [<text>]:
    description: Join a practice queue (Minemen-style)
    trigger:
        if arg-1 is not set:
            send "&8[&5Queue&8] &7Usage: &f/play <mode>"
            send "&7Modes: &eeval&7, &edrain&7, &efree&7, &euhc&7, &esword&7, &eaxe&7, &enethpot&7, &emace&7, &espear-mace&7, &esmp&7, &ecart"
            stop
        set {_mode} to arg-1
        if modeToKit({_mode}) is "":
            send "&8[&5Queue&8] &cUnknown mode &e'%{_mode}%'&c."
            send "&7Modes: &eeval&7, &edrain&7, &efree&7, &euhc&7, &esword&7, &eaxe&7, &enethpot&7, &emace&7, &espear-mace&7, &esmp&7, &ecart"
            stop
        set {_uid} to "%uuid of player%"
        if {duel::%{_uid}%::opp} is set:
            send "&8[&5Queue&8] &cYou are already in a duel. Use &f/forfeit &cto leave."
            stop
        if {queue::player::%{_uid}%} is set:
            if {queue::player::%{_uid}%} is {_mode}:
                send "&8[&5Queue&8] &cYou are already in the &e%modeLabel({_mode})% &cqueue."
                stop
            leaveQueue({_uid})
        set {_elo} to getElo({_uid}, {_mode})
        add {_uid} to {queue::list::%{_mode}%::*}
        set {queue::player::%{_uid}%} to {_mode}
        send "&8[&5Queue&8] &aJoined &f%modeLabel({_mode})% &aqueue. &8(&7ELO: &f%{_elo}%&8)"
        send "&8[&5Queue&8] &7Players in queue: &f%size of {queue::list::%{_mode}%::*}%"
        tryMatch({_mode})

# ── /unqueue ──────────────────────────────────────────────────────────────────

command /unqueue:
    description: Leave the practice queue
    aliases: /leave, /dequeue
    trigger:
        set {_uid} to "%uuid of player%"
        if {queue::player::%{_uid}%} is not set:
            send "&8[&5Queue&8] &cYou are not in a queue."
            stop
        set {_mode} to {queue::player::%{_uid}%}
        leaveQueue({_uid})
        send "&8[&5Queue&8] &cLeft the &e%modeLabel({_mode})% &cqueue."

# ── ELO update + spectator cleanup on death ───────────────────────────────

on death of player:
    set {_uid} to "%uuid of player%"
    # --- ELO update (queued matches only) ---
    set {_mode} to {duel::queue_mode::%{_uid}%}
    if {_mode} is set:
        if {duel::%{_uid}%::opp} is set:
            set {_opp_uid} to {duel::%{_uid}%::opp}
            set {_total} to {duel::%{_uid}%::rounds}
            set {_needed} to floor({_total} / 2) + 1
            wait 1 tick
            set {_w_opp} to {duel::%{_opp_uid}%::wins} ? 0
            if {_w_opp} >= {_needed}:
                set {_myElo} to getElo({_uid}, {_mode})
                set {_oppElo} to getElo({_opp_uid}, {_mode})
                set {_newMyElo} to calcElo({_myElo}, {_oppElo}, false)
                set {_newOppElo} to calcElo({_oppElo}, {_myElo}, true)
                setElo({_uid}, {_mode}, {_newMyElo})
                setElo({_opp_uid}, {_mode}, {_newOppElo})
                add 1 to {stats::%{_uid}%::losses}
                add 1 to {stats::%{_opp_uid}%::wins}
                set {_myDelta} to round({_newMyElo}) - round({_myElo})
                set {_oppDelta} to round({_newOppElo}) - round({_oppElo})
                loop all players:
                    if "%uuid of loop-player%" is {_uid}:
                        send "&8[&5ELO&8] &c%{_myDelta}% &8(&7%modeLabel({_mode})%: &f%round({_newMyElo})%&8)" to loop-player
                    if "%uuid of loop-player%" is {_opp_uid}:
                        send "&8[&5ELO&8] &a+%{_oppDelta}% &8(&7%modeLabel({_mode})%: &f%round({_newOppElo})%&8)" to loop-player
                delete {duel::queue_mode::%{_uid}%}
                delete {duel::queue_mode::%{_opp_uid}%}
    # --- Spectator cleanup (3s delay so they see the death) ---
    wait 3 seconds
    if {duel::%{_uid}%::opp} is not set:
        loop all players:
            set {_suid} to "%uuid of loop-player%"
            if {spectating::%{_suid}%} is {_uid}:
                delete {spectating::%{_suid}%}
                set gamemode of loop-player to adventure
                send "&8[&5Spectate&8] &7The duel you were watching ended." to loop-player

# ── Quit cleanup ──────────────────────────────────────────────────────────────

on quit:
    set {_uid} to "%uuid of player%"
    if {spectating::%{_uid}%} is set:
        delete {spectating::%{_uid}%}
    if {queue::player::%{_uid}%} is set:
        leaveQueue({_uid})

# ── /spectate ──────────────────────────────────────────────────────────────────

command /spectate <player>:
    description: Watch an ongoing duel
    trigger:
        set {_uid} to "%uuid of player%"
        if {duel::%{_uid}%::opp} is set:
            send "&8[&5Spectate&8] &cYou are in a duel. Use &f/forfeit &cfirst."
            stop
        if arg-1 is not online:
            send "&8[&5Spectate&8] &cPlayer &e%arg-1% &cis not online."
            stop
        set {_tuid} to "%uuid of arg-1%"
        if {duel::%{_tuid}%::opp} is not set:
            send "&8[&5Spectate&8] &e%arg-1% &cis not in a duel."
            stop
        set {spectating::%{_uid}%} to {_tuid}
        set gamemode of player to spectator
        teleport player to arg-1
        send "&8[&5Spectate&8] &aSpectating &f%arg-1%&a's duel. &7Type &f/unspectate &7to stop."

command /unspectate:
    description: Stop spectating
    trigger:
        set {_uid} to "%uuid of player%"
        if {spectating::%{_uid}%} is not set:
            send "&8[&5Spectate&8] &cYou are not spectating."
            stop
        delete {spectating::%{_uid}%}
        set gamemode of player to adventure
        send "&8[&5Spectate&8] &cStopped spectating."

# ── /stats ──────────────────────────────────────────────────────────────────────

command /stats [<offline player>]:
    description: View your stats or another player's
    trigger:
        set {_p} to arg-1 ? player
        set {_uid} to "%uuid of {_p}%"
        set {_w} to {stats::%{_uid}%::wins} ? 0
        set {_l} to {stats::%{_uid}%::losses} ? 0
        set {_total} to {_w} + {_l}
        if {_total} > 0:
            set {_wlr} to round({_w} * 100 / {_total})
        else:
            set {_wlr} to 0
        send ""
        send "&8[&5RyftPvP &8| &5Stats&8] &f%{_p}%"
        send "&7Wins: &a%{_w}%  &7Losses: &c%{_l}%  &7Win rate: &e%{_wlr}%%%"
        send ""
        send "&7ELO:"
        send "  &eEval&8:       &f%getElo({_uid}, ""eval"")%"
        send "  &eDrain&8:      &f%getElo({_uid}, ""drain"")%"
        send "  &eSword&8:      &f%getElo({_uid}, ""sword"")%"
        send "  &eAxe&8:        &f%getElo({_uid}, ""axe"")%"
        send "  &eNethPot&8:    &f%getElo({_uid}, ""nethpot"")%"
        send "  &eMace&8:       &f%getElo({_uid}, ""mace"")%"
        send "  &eSpear-Mace&8: &f%getElo({_uid}, ""spear-mace"")%"
        send "  &eUHC&8:        &f%getElo({_uid}, ""uhc"")%"
        send "  &eFree&8:       &f%getElo({_uid}, ""free"")%"
        send "  &eSMP&8:        &f%getElo({_uid}, ""smp"")%"
        send "  &eCart&8:       &f%getElo({_uid}, ""cart"")%"
        send ""

# ── /lb ────────────────────────────────────────────────────────────────────────

command /lb <text>:
    description: Show top 10 ELO leaderboard for a mode
    aliases: /leaderboard
    trigger:
        set {_mode} to arg-1
        if modeToKit({_mode}) is "":
            send "&cUnknown mode. Valid: eval, drain, free, uhc, sword, axe, nethpot, mace, spear-mace, smp, cart"
            stop
        send ""
        send "&8[&5RyftPvP &8| &5%modeLabel({_mode})% Leaderboard&8]"
        # Collect all players that have ELO for this mode
        set {_lbcount} to 0
        loop all offline players:
            set {_luid} to "%uuid of loop-player%"
            if {elo::%{_luid}%::%{_mode}%} is set:
                add 1 to {_lbcount}
                set {_lb::uid::%{_lbcount}%} to {_luid}
                set {_lb::elo::%{_lbcount}%} to {elo::%{_luid}%::%{_mode}%}
                set {_lb::name::%{_lbcount}%} to "%loop-player%"
        # Find top 10 using selection — pick the highest each pass
        set {_shown} to min({_lbcount}, 10)
        if {_shown} is 0:
            send "&7No ranked matches played yet."
        else:
            set {_rank} to 0
            loop {_shown} times:
                add 1 to {_rank}
                # Find the max elo among remaining entries
                set {_maxElo} to -1
                set {_maxIdx} to -1
                loop {_lbcount} times:
                    set {_i} to loop-value
                    if {_lb::uid::%{_i}%} is set:
                        if {_lb::elo::%{_i}%} > {_maxElo}:
                            set {_maxElo} to {_lb::elo::%{_i}%}
                            set {_maxIdx} to {_i}
                if {_maxIdx} > 0:
                    send "&8%{_rank}%. &f%{_lb::name::%{_maxIdx}%}% &8- &a%{_maxElo}% ELO"
                    delete {_lb::uid::%{_maxIdx}%}
                    delete {_lb::elo::%{_maxIdx}%}
                    delete {_lb::name::%{_maxIdx}%}
        send ""
        # Clean up remaining temp vars
        loop {_lbcount} times:
            delete {_lb::uid::%loop-value%}
            delete {_lb::elo::%loop-value%}
            delete {_lb::name::%loop-value%}
        delete {_lbcount}

# ── /elo reset ────────────────────────────────────────────────────────────────

command /elo <text> [<offline player>]:
    description: ELO admin commands
    permission: op
    trigger:
        if arg-1 is "reset":
            if arg-2 is not set:
                send "&cUsage: /elo reset <player>"
                stop
            set {_uid} to "%uuid of arg-2%"
            loop {"eval", "drain", "free", "uhc", "sword", "axe", "nethpot", "mace", "spear-mace", "smp", "cart"}:
                delete {elo::%{_uid}%::%loop-value%}
            delete {stats::%{_uid}%::wins}
            delete {stats::%{_uid}%::losses}
            send "&aReset ELO and stats for &f%arg-2%&a."
        else:
            send "&cUsage: /elo reset <player>"
