# RyftTiers duel system — replaces Duels plugin
# Requires: Skript 2.17+
#
# Setup: /setarena <name> 1  (stand at spawn 1) then /setarena <name> 2
# /duel <player> [mode]  — challenge
# /duel accept | deny     — respond
# /forfeit                — leave a duel
# /sdk <mode>             — save kit from creative inventory (defined here, replaces duel savekit)

# ── Kit helpers ───────────────────────────────────────────────────────────────
# Saves slots 0-35 + armor + offhand under the kit name.

function saveKit(name: text, p: player):
    loop integers from 0 to 35:
        set {duelkit::%{_name}%::inv::%loop-value%} to slot loop-value of {_p}'s inventory
    set {duelkit::%{_name}%::a0} to boots of {_p}
    set {duelkit::%{_name}%::a1} to leggings of {_p}
    set {duelkit::%{_name}%::a2} to chestplate of {_p}
    set {duelkit::%{_name}%::a3} to helmet of {_p}
    set {duelkit::%{_name}%::oh} to off hand item of {_p}
    set {duelkit::%{_name}%::exists} to true

function applyKit(name: text, p: player):
    clear {_p}'s inventory
    loop integers from 0 to 35:
        set slot loop-value of {_p}'s inventory to {duelkit::%{_name}%::inv::%loop-value%}
    set boots of {_p} to {duelkit::%{_name}%::a0}
    set leggings of {_p} to {duelkit::%{_name}%::a1}
    set chestplate of {_p} to {duelkit::%{_name}%::a2}
    set helmet of {_p} to {duelkit::%{_name}%::a3}
    set off hand item of {_p} to {duelkit::%{_name}%::oh}

function kitExists(name: text) :: boolean:
    if {duelkit::%{_name}%::exists} is true:
        return true
    return false

# ── Inventory save/restore ────────────────────────────────────────────────────

function saveInv(uid: text, p: player):
    loop integers from 0 to 35:
        set {saved_inv::%{_uid}%::%loop-value%} to slot loop-value of {_p}'s inventory
    set {saved_inv::%{_uid}%::a0} to boots of {_p}
    set {saved_inv::%{_uid}%::a1} to leggings of {_p}
    set {saved_inv::%{_uid}%::a2} to chestplate of {_p}
    set {saved_inv::%{_uid}%::a3} to helmet of {_p}
    set {saved_inv::%{_uid}%::oh} to off hand item of {_p}
    set {saved_inv::%{_uid}%::gm} to gamemode of {_p}

function restoreInv(uid: text, p: player):
    clear {_p}'s inventory
    loop integers from 0 to 35:
        if {saved_inv::%{_uid}%::%loop-value%} is set:
            set slot loop-value of {_p}'s inventory to {saved_inv::%{_uid}%::%loop-value%}
        delete {saved_inv::%{_uid}%::%loop-value%}
    if {saved_inv::%{_uid}%::a0} is set:
        set boots of {_p} to {saved_inv::%{_uid}%::a0}
    if {saved_inv::%{_uid}%::a1} is set:
        set leggings of {_p} to {saved_inv::%{_uid}%::a1}
    if {saved_inv::%{_uid}%::a2} is set:
        set chestplate of {_p} to {saved_inv::%{_uid}%::a2}
    if {saved_inv::%{_uid}%::a3} is set:
        set helmet of {_p} to {saved_inv::%{_uid}%::a3}
    if {saved_inv::%{_uid}%::oh} is set:
        set off hand item of {_p} to {saved_inv::%{_uid}%::oh}
    delete {saved_inv::%{_uid}%::a0}
    delete {saved_inv::%{_uid}%::a1}
    delete {saved_inv::%{_uid}%::a2}
    delete {saved_inv::%{_uid}%::a3}
    delete {saved_inv::%{_uid}%::oh}
    delete {saved_inv::%{_uid}%::gm}

# ── Duel cleanup helper ───────────────────────────────────────────────────────

function cleanupPlayer(uid: text, p: player):
    delete {duel::%{_uid}%::opp}
    delete {duel::%{_uid}%::kit}
    delete {duel::%{_uid}%::label}
    delete {duel::%{_uid}%::rounds}
    delete {duel::%{_uid}%::wins}
    delete {duel::%{_uid}%::spawn}
    delete {duel::%{_uid}%::istest}
    heal {_p}
    set food level of {_p} to 20
    remove all potion effects from {_p}
    restoreInv({_uid}, {_p})
    set gamemode of {_p} to adventure

# ── Start round ───────────────────────────────────────────────────────────────

function startRound(uid1: text, uid2: text, p1: player, p2: player):
    set {_label} to {duel::%{_uid1}%::label}
    set {_w1} to {duel::%{_uid1}%::wins} ? 0
    set {_w2} to {duel::%{_uid2}%::wins} ? 0
    set {_total} to {duel::%{_uid1}%::rounds}
    heal {_p1}
    set food level of {_p1} to 20
    remove all potion effects from {_p1}
    heal {_p2}
    set food level of {_p2} to 20
    remove all potion effects from {_p2}
    applyKit({duel::%{_uid1}%::kit}, {_p1})
    applyKit({duel::%{_uid1}%::kit}, {_p2})
    teleport {_p1} to {duel::%{_uid1}%::spawn}
    teleport {_p2} to {duel::%{_uid2}%::spawn}
    set gamemode of {_p1} to survival
    set gamemode of {_p2} to survival
    send "&8[&5Duels&8] &7&l%{_label}% &8| &e%{_p1}%&7: &a%{_w1}% &7- &e%{_p2}%&7: &a%{_w2}% &8(best of %{_total}%)" to {_p1}
    send "&8[&5Duels&8] &7&l%{_label}% &8| &e%{_p1}%&7: &a%{_w1}% &7- &e%{_p2}%&7: &a%{_w2}% &8(best of %{_total}%)" to {_p2}

# ── Start duel (called by /duel accept and tiertest auto-start) ───────────────

function startDuelNow(uid1: text, uid2: text, p1: player, p2: player, kit: text, label: text, rounds: number, istest: boolean):
    set {_arena} to random element of {arenas::list::*}
    if {_arena} is not set:
        send "&cNo arenas set up. Ask an op to /setarena <name> 1 and /setarena <name> 2." to {_p1}
        send "&cNo arenas set up." to {_p2}
        stop
    if {arena::%{_arena}%::1} is not set or {arena::%{_arena}%::2} is not set:
        send "&cArena %{_arena}% is missing a spawn point." to {_p1}
        send "&cArena %{_arena}% is missing a spawn point." to {_p2}
        stop
    if kitExists({_kit}) is false:
        send "&cKit &e%{_kit}% &chas not been saved yet. Use &f/sdk %{_kit}% &cin creative." to {_p1}
        send "&cKit &e%{_kit}% &chas not been saved yet." to {_p2}
        stop
    saveInv({_uid1}, {_p1})
    saveInv({_uid2}, {_p2})
    set {duel::%{_uid1}%::opp} to {_uid2}
    set {duel::%{_uid1}%::kit} to {_kit}
    set {duel::%{_uid1}%::label} to {_label}
    set {duel::%{_uid1}%::rounds} to {_rounds}
    set {duel::%{_uid1}%::wins} to 0
    set {duel::%{_uid1}%::spawn} to {arena::%{_arena}%::1}
    set {duel::%{_uid1}%::istest} to {_istest}
    set {duel::%{_uid2}%::opp} to {_uid1}
    set {duel::%{_uid2}%::kit} to {_kit}
    set {duel::%{_uid2}%::label} to {_label}
    set {duel::%{_uid2}%::rounds} to {_rounds}
    set {duel::%{_uid2}%::wins} to 0
    set {duel::%{_uid2}%::spawn} to {arena::%{_arena}%::2}
    set {duel::%{_uid2}%::istest} to {_istest}
    startRound({_uid1}, {_uid2}, {_p1}, {_p2})

# ── /setarena ─────────────────────────────────────────────────────────────────

command /setarena <text> <integer>:
    description: Set arena spawn points (op only)
    permission: op
    trigger:
        if arg-2 is not 1 and arg-2 is not 2:
            send "&cUsage: /setarena <name> 1|2"
            stop
        set {arena::%arg-1%::%arg-2%} to location of player
        add arg-1 to {arenas::list::*}
        send "&8[&5Duels&8] &aSet arena &f%arg-1% &apoint &f%arg-2%&a."

# ── /sdk — Save kit from creative inventory ───────────────────────────────────

command /sdk <text>:
    description: Save your current inventory as the default kit for a gamemode
    permission: ryft.tester
    trigger:
        if gamemode of player is not creative:
            send "&8[&5SDK&8] &cYou must be in &fCreative &cmode to save a kit."
            stop
        set {_gm} to arg-1
        if {_gm} is "free":
            set {_kit} to "vanilla-free"
        else if {_gm} is "eval":
            set {_kit} to "vanilla-eval"
        else if {_gm} is "drain":
            set {_kit} to "vanilla-drain"
        else if {_gm} is "uhc":
            set {_kit} to "uhc"
        else if {_gm} is "sword":
            set {_kit} to "sword"
        else if {_gm} is "axe":
            set {_kit} to "axe"
        else if {_gm} is "nethpot":
            set {_kit} to "nethpot"
        else if {_gm} is "mace":
            set {_kit} to "mace"
        else if {_gm} is "spear-mace" or {_gm} is "spearmace":
            set {_kit} to "spear-mace"
        else if {_gm} is "smp":
            set {_kit} to "smp"
        else if {_gm} is "cart":
            set {_kit} to "cart"
        else:
            send "&8[&5SDK&8] &cUnknown gamemode &e'%{_gm}%'&c."
            send "&7Valid: &efree&7, &eeval&7, &edrain&7, &euhc&7, &esword&7, &eaxe&7, &enethpot&7, &emace&7, &espear-mace&7, &esmp&7, &ecart"
            stop
        saveKit({_kit}, player)
        send "&8[&5SDK&8] &aSaved inventory as kit &f%{_kit}%&a."

# ── /duel ─────────────────────────────────────────────────────────────────────

command /duel <text> [<text>]:
    description: Challenge a player to a duel, or accept/deny a request
    trigger:
        set {_sub} to arg-1
        # Accept / deny
        if {_sub} is "accept":
            set {_uid} to "%uuid of player%"
            if {duelreq::%{_uid}%::from} is not set:
                send "&8[&5Duels&8] &cYou have no pending duel request."
                stop
            set {_from_uid} to {duelreq::%{_uid}%::from}
            set {_kit}   to {duelreq::%{_uid}%::kit}
            set {_label} to {duelreq::%{_uid}%::label}
            set {_rounds} to {duelreq::%{_uid}%::rounds}
            delete {duelreq::%{_uid}%::from}
            delete {duelreq::%{_uid}%::kit}
            delete {duelreq::%{_uid}%::label}
            delete {duelreq::%{_uid}%::rounds}
            set {_challenger} to ""
            loop all players:
                if "%uuid of loop-player%" is {_from_uid}:
                    set {_challenger} to loop-player
            if {_challenger} is "":
                send "&8[&5Duels&8] &cChallenger went offline."
                stop
            startDuelNow({_from_uid}, {_uid}, {_challenger}, player, {_kit}, {_label}, {_rounds}, false)
            stop
        if {_sub} is "deny" or {_sub} is "decline":
            set {_uid} to "%uuid of player%"
            if {duelreq::%{_uid}%::from} is not set:
                send "&8[&5Duels&8] &cYou have no pending duel request."
                stop
            set {_from_uid} to {duelreq::%{_uid}%::from}
            delete {duelreq::%{_uid}%::from}
            delete {duelreq::%{_uid}%::kit}
            delete {duelreq::%{_uid}%::label}
            delete {duelreq::%{_uid}%::rounds}
            send "&8[&5Duels&8] &cDuel request declined."
            loop all players:
                if "%uuid of loop-player%" is {_from_uid}:
                    send "&8[&5Duels&8] &e%player% &cdeclined your duel request." to loop-player
            stop
        # Challenge a player
        set {_target} to {_sub} parsed as player
        if {_target} is not set:
            send "&8[&5Duels&8] &cPlayer &e%{_sub}% &cis not online."
            stop
        if {_target} is player:
            send "&8[&5Duels&8] &cYou can't duel yourself."
            stop
        set {_uid} to "%uuid of player%"
        set {_tuid} to "%uuid of {_target}%"
        if {duel::%{_uid}%::opp} is set:
            send "&8[&5Duels&8] &cYou are already in a duel."
            stop
        if {duel::%{_tuid}%::opp} is set:
            send "&8[&5Duels&8] &e%{_target}% &cis already in a duel."
            stop
        set {_mode} to arg-2 ? "eval"
        if {_mode} is "free":
            set {_kit} to "vanilla-free"
            set {_label} to "Vanilla Free"
            set {_rounds} to 3
        else if {_mode} is "eval":
            set {_kit} to "vanilla-eval"
            set {_label} to "Vanilla Eval"
            set {_rounds} to 3
        else if {_mode} is "drain":
            set {_kit} to "vanilla-drain"
            set {_label} to "Vanilla Drain"
            set {_rounds} to 3
        else if {_mode} is "uhc":
            set {_kit} to "uhc"
            set {_label} to "UHC"
            set {_rounds} to 2
        else if {_mode} is "sword":
            set {_kit} to "sword"
            set {_label} to "Sword"
            set {_rounds} to 3
        else if {_mode} is "axe":
            set {_kit} to "axe"
            set {_label} to "Axe"
            set {_rounds} to 3
        else if {_mode} is "nethpot":
            set {_kit} to "nethpot"
            set {_label} to "NethPot"
            set {_rounds} to 3
        else if {_mode} is "mace":
            set {_kit} to "mace"
            set {_label} to "Mace"
            set {_rounds} to 3
        else if {_mode} is "spear-mace" or {_mode} is "spearmace":
            set {_kit} to "spear-mace"
            set {_label} to "Spear Mace"
            set {_rounds} to 3
        else if {_mode} is "smp":
            set {_kit} to "smp"
            set {_label} to "SMP"
            set {_rounds} to 3
        else if {_mode} is "cart":
            set {_kit} to "cart"
            set {_label} to "Cart"
            set {_rounds} to 3
        else:
            send "&cUnknown mode &e'%{_mode}%'&c. Valid: eval, drain, free, uhc, sword, axe, nethpot, mace, spear-mace, smp, cart"
            stop
        # Send request
        set {duelreq::%{_tuid}%::from} to {_uid}
        set {duelreq::%{_tuid}%::kit} to {_kit}
        set {duelreq::%{_tuid}%::label} to {_label}
        set {duelreq::%{_tuid}%::rounds} to {_rounds}
        send "&8[&5Duels&8] &aDuel request sent to &e%{_target}%&a. (&f%{_label}%&a)"
        send "" to {_target}
        send "&8[&5Duels&8] &e%player% &7challenged you to a &a%{_label}% &7duel!" to {_target}
        send "&8[&5Duels&8] &7Type &a/duel accept &7or &c/duel deny" to {_target}
        send "" to {_target}
        # Auto-expire after 60s
        wait 60 seconds
        if {duelreq::%{_tuid}%::from} is {_uid}:
            delete {duelreq::%{_tuid}%::from}
            delete {duelreq::%{_tuid}%::kit}
            delete {duelreq::%{_tuid}%::label}
            delete {duelreq::%{_tuid}%::rounds}
            if {_target} is online:
                send "&8[&5Duels&8] &7Duel request from &e%player% &7expired." to {_target}
            if player is online:
                send "&8[&5Duels&8] &7Duel request to &e%{_target}% &7expired."

# ── /forfeit ──────────────────────────────────────────────────────────────────

command /forfeit:
    description: Leave a duel
    trigger:
        set {_uid} to "%uuid of player%"
        if {duel::%{_uid}%::opp} is not set:
            send "&8[&5Duels&8] &cYou are not in a duel."
            stop
        set {_opp_uid} to {duel::%{_uid}%::opp}
        set {_label} to {duel::%{_uid}%::label}
        # Find opponent
        set {_opp} to ""
        loop all players:
            if "%uuid of loop-player%" is {_opp_uid}:
                set {_opp} to loop-player
        send "&8[&5Duels&8] &cYou forfeited the &a%{_label}% &cduel."
        if {_opp} is not "":
            send "&8[&5Duels&8] &e%player% &aforfeited. You win the &f%{_label}% &aduel!" to {_opp}
            cleanupPlayer({_opp_uid}, {_opp})
        cleanupPlayer({_uid}, player)

# ── Death handling ────────────────────────────────────────────────────────────

on death of player:
    set {_uid} to "%uuid of player%"
    if {duel::%{_uid}%::opp} is not set:
        stop
    cancel event
    set {_opp_uid} to {duel::%{_uid}%::opp}
    set {_total} to {duel::%{_uid}%::rounds}
    # Award win to opponent
    add 1 to {duel::%{_opp_uid}%::wins}
    set {_w_opp} to {duel::%{_opp_uid}%::wins}
    set {_w_self} to {duel::%{_uid}%::wins} ? 0
    # Find opponent player
    set {_opp} to ""
    loop all players:
        if "%uuid of loop-player%" is {_opp_uid}:
            set {_opp} to loop-player
    set {_label} to {duel::%{_uid}%::label}
    set {_istest} to {duel::%{_uid}%::istest}
    # Check if match is over (best of N: need majority)
    set {_needed} to floor({_total} / 2) + 1
    if {_w_opp} >= {_needed}:
        # Match over — opponent wins
        broadcast "&8[&5Duels&8] &e%{_opp}% &abeat &e%player% &ain &f%{_label}% &8(%{_w_opp}%-%{_w_self}%)"
        if {_opp} is not "":
            cleanupPlayer({_opp_uid}, {_opp})
        cleanupPlayer({_uid}, player)
    else:
        # More rounds
        send "&8[&5Duels&8] &e%player% &cdied&8. Score: &e%{_opp}%&8: &a%{_w_opp}% &7- &e%player%&8: &a%{_w_self}%" to player
        if {_opp} is not "":
            send "&8[&5Duels&8] &e%player% &cdied&8. Score: &e%{_opp}%&8: &a%{_w_opp}% &7- &e%player%&8: &a%{_w_self}%" to {_opp}
        wait 2 seconds
        if {duel::%{_uid}%::opp} is set:
            if {_opp} is not "":
                startRound({_uid}, {_opp_uid}, player, {_opp})
            else:
                cleanupPlayer({_uid}, player)

# ── Disconnect cleanup ────────────────────────────────────────────────────────

on quit:
    set {_uid} to "%uuid of player%"
    if {duel::%{_uid}%::opp} is set:
        set {_opp_uid} to {duel::%{_uid}%::opp}
        set {_label} to {duel::%{_uid}%::label}
        loop all players:
            if "%uuid of loop-player%" is {_opp_uid}:
                send "&8[&5Duels&8] &e%player% &cdisconnected. &f%{_label}% &cduel cancelled." to loop-player
                cleanupPlayer({_opp_uid}, loop-player)
        delete {duel::%{_uid}%::opp}
        delete {duel::%{_uid}%::kit}
        delete {duel::%{_uid}%::label}
        delete {duel::%{_uid}%::rounds}
        delete {duel::%{_uid}%::wins}
        delete {duel::%{_uid}%::spawn}
        delete {duel::%{_uid}%::istest}
